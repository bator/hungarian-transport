# Gitignored live file is `.env` next to this repo, or
# `/config/hungarian-transport/.env` on Home Assistant.
# GitHub Actions: repository secrets with the same names.
#
# Do not commit real values. Public CI falls back to menetbrand.
# MÁV rail GTFS is registration-only; keep the zip local (gitignored).

BAHART_GTFS_URL=
MOBILITY_DATABASE_REFRESH_TOKEN=
TRANSITLAND_API_KEY=
# When set, mav-gtfs.zip in the working folder (/config/hungarian-transport on
# Home Assistant) is this URL's copy, downloaded again once it is 20 hours old.
MAV_GTFS_URL=
MAV_GTFS_ZIP=
# Unzipped pfaedle output (OSM-matched rails). Preferred over the official zip.
MAV_PFAEDLE_DIR=
# City feed ids (comma-separated, or "all") a rebuild may lose against the
# index it replaces. Leave empty: a missing feed then keeps the old index.
HUNGARIAN_TRANSPORT_ALLOW_MISSING=
